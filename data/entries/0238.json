list","text":"They Lie Above"},{"kind":"list","text":"The Tangi Virus"},{"kind":"list","text":"Any Analog Horror works, including a few already mentioned (this place is not happy, The SMILE Tapes, Gemini Home Entertainment, Monument Mythos, Vita Carnis, The Walten Files, etc.)"},{"kind":"heading","text":"Other"},{"kind":"list","text":"The SCP Foundation"},{"kind":"list","text":"Tales from the Gas Station"},{"kind":"list","text":"Works of H.P. Lovecraft"},{"kind":"list","text":"Alternate Reality Games"},{"kind":"list","text":"The Backrooms"},{"kind":"heading","text":"Music"},{"kind":"paragraph","text":"Cryptidcore music is either directly about cryptids, supernatural entities, or eerie feelings. Common genres include alternative, electropunk, indie, and rock."},{"kind":"heading","text":"Artists"},{"kind":"list","text":"Lemon Demon"},{"kind":"list","text":"Tally Hall"},{"kind":"list","text":"Mother Mother"},{"kind":"list","text":"Nick Seigel"},{"kind":"list","text":"Bear Ghost"},{"kind":"list","text":"Cavetown"},{"kind":"list","text":"The Scary Jokes"},{"kind":"list","text":"Julee Cruise"},{"kind":"list","text":"Orkforge"},{"kind":"list","text":"Jack Stauber"},{"kind":"list","text":"The Bad First Impressions"},{"kind":"list","text":"MGMT"},{"kind":"list","text":"Bears in Trees"},{"kind":"list","text":"Vundabar"},{"kind":"list","text":"Averno"},{"kind":"list","text":"Amanda Palmer (and Dresden Dolls)"},{"kind":"list","text":"Rob Cantor"},{"kind":"list","text":"Penelope Scott"},{"kind":"list","text":"Jonathan Coulton"},{"kind":"list","text":"Yaelokre"},{"kind":"list","text":"Rabbitology"},{"kind":"list","text":"Will Wood (and the Tapeworms)"},{"kind":"list","text":"They Might Be Giants"},{"kind":"list","text":"Evelyn Evelyn"},{"kind":"list","text":"The Homecoming"},{"kind":"list","text":"Elio Mei"},{"kind":"heading","text":"Songs"},{"kind":"list","text":"\"Touch-Tone Telephone\" by Lemon Demon"},{"kind":"list","text":"\"Eighth Wonder\" by Lemon Demon"},{"kind":"list","t